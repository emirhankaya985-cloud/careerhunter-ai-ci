# rules | nvidia | groq | gemini | ollama | openai_compatible
LLM_PROVIDER=rules
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
NVIDIA_SUPER_API_KEY=
NVIDIA_ULTRA_API_KEY=
GROQ_API_KEY=
MAX_DAILY_LLM_CALLS=20
MAX_DAILY_TOKENS=50000
MAX_DAILY_COST_USD=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CAREERHUNTER_DB=data/careerhunter.db
# Durable cloud storage. Put the real value in GitHub Secrets, never in this file.
DATABASE_URL=
NTFY_TOPIC=


# Private Render dashboard: set actual values in Render Environment ONLY (not GitHub).
# Dedicated PostgreSQL SELECT-only user, different from the collector DATABASE_URL.
DASHBOARD_DATABASE_URL=
# Generate a unique 16+ character login password; never commit it.
DASHBOARD_PASSWORD=
# Generate a unique random 32+ character signing secret; rotate to revoke all sessions.
DASHBOARD_SESSION_SECRET=
DASHBOARD_SECURE_COOKIE=true
